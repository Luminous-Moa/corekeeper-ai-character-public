      "value": [
        {
          "from": "request",
          "refs": [
            "Pug.Other/ShovelSlot.cs:161-175",
            "Pug.Other/PlayerAttackSystem.cs:429-456",
            "Pug.Other/PlayerController.cs:6649-6669"
          ],
          "text": "PlayerAttackSystem dispatches to DealCritterDamage, which casts the shovel-size box and calls ClientSystem.DealDamageToEntity with base 1.",
          "to": "damage_call"
        },
        {
          "from": "damage_call",
          "refs": [
            "Pug.Other/PlayerCommand/ClientSystem.cs:279-287",
            "Pug.Other/PlayerCommand/ClientSystem.cs:292-368",
            "Pug.Other/PlayerCommand/ClientSystem.cs:477-478",
            "Pug.Other/EntityUtility.cs:835-878",
            "Pug.Other/EntityUtility.cs:1491-1567"
          ],
          "text": "GetDamageInfo calculates damage and immunity, then for a non-PlayerGhost target EntityUtility.DealDamage queues a negative pre-reduction amount when the target has HealthCD. GetDamageInfo indexes target health earlier; do not assume missing HealthCD is safely ignored. A PlayerGhost branches to RegisterPlayerHit and returns.",
          "to": "health_buffer"
        },
        {
          "from": "health_buffer",
          "refs": [
            "Pug.Other/UpdateHealthFromBufferSystem.cs:194-302",
            "Pug.Other/UpdateHealthFromBufferSystem.cs:384-435",
            "Pug.Other/UpdateHealthFromBufferSystem.cs:558-560"
          ],
          "text": "The buffer applies reduction, positive minDamagePerHit even when calculated amount is zero, maxDamagePerHit, and IgnoreDamageFromSelfOrPlayerSource. For applyToNonPredicted=false and disabled Simulate, local processing continues without the final healthLookup write. Otherwise amount is accumulated; wasKilled overrides it to negative current health. ProtectiveArmor can set the accumulated change to zero and skip the health write. Other eligible paths clamp and write HealthCD; the buffer is cleared.",
          "to": "health_write"
        }
      ]
    },
